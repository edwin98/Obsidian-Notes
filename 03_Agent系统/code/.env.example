# 默认 CLI 和新版入口无需密钥；main.py --online 才调用在线模型。
DEEPSEEK_API_KEY=
# API 离线演示时设置 AGENT_MODE=offline，AGENT_SCENARIO 可选 pass/regression/danger/review。
AGENT_MODE=online
AGENT_SCENARIO=pass
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=5g-test-agent
POSTGRES_URI=postgresql://postgres:password@localhost:5432/agent_db
# 新入口独立配置；AGENT_MODE/AGENT_SCENARIO 仅控制保留的旧图接口。
AGENT_TASK_MODE=offline
# 默认 :memory:；改成文件路径可保存任务和消息，仍仅支持单进程本机演示。
AGENT_TASK_DB=:memory:
